library(caret)
library(dplyr)
library(knitr)
library(ggplot2)
set.seed(123)
Carseats_Filtered <- Carseats %>% select(Sales, Price, Advertising, Population, Age, Income, Education)
#B1#####################################
ctrl <- trainControl(method = "cv", number = 10)
svm_model <- train(
Sales ~ .,
data = Carseats_Filtered,
method = "svmLinear",
trControl = ctrl
)
svm_results_clean <- svm_model$results %>%
select(C, RMSE, Rsquared, MAE) %>%
mutate(across(where(is.numeric), round, 4))
kable(svm_results_clean, caption = "Linear SVM Performance (Default)")
#B2#####################################
#B3#####################################
#B4#####################################
library(ISLR)
library(caret)
library(dplyr)
library(knitr)
library(ggplot2)
set.seed(123)
Carseats_Filtered <- Carseats %>% select(Sales, Price, Advertising, Population, Age, Income, Education)
#B1#####################################
ctrl <- trainControl(method = "cv", number = 10)
svm_model <- train(
Sales ~ .,
data = Carseats_Filtered,
method = "svmLinear",
trControl = ctrl
)
svm_results_clean <- svm_model$results %>%
select(C, RMSE, Rsquared, MAE) %>%
mutate(across(where(is.numeric), round, 4))
kable(svm_results_clean, caption = "Linear SVM Performance (Default)")
#B2#####################################
ctrl_rep <- trainControl(
method = "repeatedcv",
number = 5,
repeats = 2
)
grid <- expand.grid(C = c(0.1, 0.5, 1, 10))
svm_tuned <- train(
Sales ~ .,
data = Carseats_Filtered,
method = "svmLinear",
trControl = ctrl_rep,
tuneGrid = grid
)
svm_tuned_clean <- svm_tuned$results %>%
select(C, RMSE, Rsquared, MAE) %>%
arrange(desc(Rsquared)) %>%
mutate(across(where(is.numeric), round, 4))
kable(svm_tuned_clean, caption = "Tuned SVM Performance by Cost Parameter (C)")
best_svm <- svm_tuned$results %>%
filter(C == svm_tuned$bestTune$C) %>%
mutate(across(where(is.numeric), round, 4))
kable(best_svm, caption = "Best SVM Model")
#B3#####################################
#B4#####################################
library(ISLR)
library(caret)
library(dplyr)
library(knitr)
library(ggplot2)
set.seed(123)
Carseats_Filtered <- Carseats %>% select(Sales, Price, Advertising, Population, Age, Income, Education)
#B1#####################################
ctrl <- trainControl(method = "cv", number = 10)
svm_model <- train(
Sales ~ .,
data = Carseats_Filtered,
method = "svmLinear",
trControl = ctrl
)
svm_results_clean <- svm_model$results %>%
select(C, RMSE, Rsquared, MAE) %>%
mutate(across(where(is.numeric), round, 4))
kable(svm_results_clean, caption = "Linear SVM Performance (Default)")
#B2#####################################
ctrl_rep <- trainControl(
method = "repeatedcv",
number = 5,
repeats = 2
)
grid <- expand.grid(C = c(0.1, 0.5, 1, 10))
svm_tuned <- train(
Sales ~ .,
data = Carseats_Filtered,
method = "svmLinear",
trControl = ctrl_rep,
tuneGrid = grid
)
svm_tuned_clean <- svm_tuned$results %>%
select(C, RMSE, Rsquared, MAE) %>%
arrange(desc(Rsquared)) %>%
mutate(across(where(is.numeric), round, 4))
kable(svm_tuned_clean, caption = "Tuned SVM Performance by Cost Parameter (C)")
best_svm <- svm_tuned$results %>%
filter(C == svm_tuned$bestTune$C) %>%
mutate(across(where(is.numeric), round, 4))
kable(best_svm, caption = "Best SVM Model")
#B3#####################################
nn_model <- train(
Sales ~ .,
data = Carseats_Filtered,
method = "nnet",
preProcess = c("center", "scale"),
trControl = ctrl,
trace = FALSE
)
nn_results_clean <- nn_model$results %>%
select(size, decay, RMSE, Rsquared, MAE) %>%
arrange(desc(Rsquared)) %>%
mutate(across(where(is.numeric), round, 4))
kable(nn_results_clean, caption = "Neural Network Performance")
best_nn <- nn_model$results %>%
filter(size == nn_model$bestTune$size,
decay == nn_model$bestTune$decay) %>%
mutate(across(where(is.numeric), round, 4))
kable(best_nn, caption = "Best Neural Network Model")
#B4#####################################
library(ISLR)
library(caret)
library(dplyr)
library(knitr)
library(ggplot2)
set.seed(123)
Carseats_Filtered <- Carseats %>% select(Sales, Price, Advertising, Population, Age, Income, Education)
#B1#####################################
ctrl <- trainControl(method = "cv", number = 10)
svm_model <- train(
Sales ~ .,
data = Carseats_Filtered,
method = "svmLinear",
trControl = ctrl
)
svm_results_clean <- svm_model$results %>%
select(C, RMSE, Rsquared, MAE) %>%
mutate(across(where(is.numeric), round, 4))
kable(svm_results_clean, caption = "Linear SVM Performance (Default)")
#B2#####################################
ctrl_rep <- trainControl(
method = "repeatedcv",
number = 5,
repeats = 2
)
grid <- expand.grid(C = c(0.1, 0.5, 1, 10))
svm_tuned <- train(
Sales ~ .,
data = Carseats_Filtered,
method = "svmLinear",
trControl = ctrl_rep,
tuneGrid = grid
)
svm_tuned_clean <- svm_tuned$results %>%
select(C, RMSE, Rsquared, MAE) %>%
arrange(desc(Rsquared)) %>%
mutate(across(where(is.numeric), round, 4))
kable(svm_tuned_clean, caption = "Tuned SVM Performance by Cost Parameter (C)")
best_svm <- svm_tuned$results %>%
filter(C == svm_tuned$bestTune$C) %>%
mutate(across(where(is.numeric), round, 4))
kable(best_svm, caption = "Best SVM Model")
#B3#####################################
nn_model <- train(
Sales ~ .,
data = Carseats_Filtered,
method = "nnet",
preProcess = c("center", "scale"),
trControl = ctrl,
trace = FALSE
)
nn_results_clean <- nn_model$results %>%
select(size, decay, RMSE, Rsquared, MAE) %>%
arrange(desc(Rsquared)) %>%
mutate(across(where(is.numeric), round, 4))
kable(nn_results_clean, caption = "Neural Network Performance")
best_nn <- nn_model$results %>%
filter(size == nn_model$bestTune$size,
decay == nn_model$bestTune$decay) %>%
mutate(across(where(is.numeric), round, 4))
kable(best_nn, caption = "Best Neural Network Model")
#B4#####################################
new_data <- data.frame(
Price = 6.54,
Advertising = 0,
Population = 124,
Age = 76,
Income = 110,
Education = 10 )
pred <- predict(nn_model, newdata = new_data)
cat("Estimated Sales:", round(pred, 3))
library(tinytex) # Knit to pdf
library(ISLR) # Datasets
library(dplyr)
library(glmnet)
library(caret)
set.seed(123)
Carseats_Filtered <- Carseats %>% select("Sales", "Price",
"Advertising","Population","Age","Income","Education")
#B1#####################################
ctrl <- trainControl(method = "cv", number = 10)
svm_model <- train(
Sales ~ .,
data = Carseats_Filtered,
method = "svmLinear",
trControl = ctrl
)
# svm_model
# svm_model$results$Rsquared # Show Rsq
cat("R-squared:", round(svm_model$results$Rsquared, 4), "\n\n")
#B2#####################################
ctrl_rep <- trainControl(
method = "repeatedcv",
number = 5,
repeats = 2
)
grid <- expand.grid(C = c(0.1, 0.5, 1, 10))
svm_tuned <- train(
Sales ~ .,
data = Carseats_Filtered,
method = "svmLinear",
trControl = ctrl_rep,
tuneGrid = grid
)
#svm_tuned
#svm_tuned$results # Show C performance
#svm_tuned$bestTune # Reveal the best model
for(i in 1:nrow(svm_tuned$results)) {
cat("C =", svm_tuned$results$C[i],
"| R² =", round(svm_tuned$results$Rsquared[i], 4),
"| RMSE =", round(svm_tuned$results$RMSE[i], 4), "\n")
}
cat("Best C =", svm_tuned$bestTune$C, "\n\n")
#B3#####################################
nn_model <- train(
Sales ~ .,
data = Carseats_Filtered,
method = "nnet",
preProcess = c("center", "scale"),
trControl = ctrl,
trace = FALSE,
maxit = 500
)
#nn_model
#nn_model$results # Show model
#nn_model$bestTune # Reveal best model
for(i in 1:nrow(nn_model$results)) {
cat("Size =", nn_model$results$size[i],
"| Decay =", nn_model$results$decay[i],
"| R² =", round(nn_model$results$Rsquared[i], 4),
"| RMSE =", round(nn_model$results$RMSE[i], 4), "\n")
}
cat("Size =", nn_model$bestTune$size,
"| Decay =", nn_model$bestTune$decay, "\n\n")
#B4#####################################
new_data <- data.frame(
Price = 6.54,
Advertising = 0,
Population = 124,
Age = 76,
Income = 110,
Education = 10
)
cat("Estimated Sales:", round(predict(nn_model, newdata = new_data), 3), "\n")
# Load packages
library(tidyverse)
library(caret)
library(cluster)
set.seed(4827)
# Load dataset
fuel <- read_csv("monthly_fuel_costs.csv")
# Data overview
#glimpse(fuel)
# Null percentages
sapply(
fuel[c("mercury_content_ppm",
"moisture_content_pct",
"chlorine_content_ppm")],
function(x) mean(x == "null" | is.na(x)) * 100
)
# Uniqueness testing
sapply(fuel, function(x) length(unique(x)))
#table(fuel$data_maturity)
#table(fuel$fuel_cost_per_mmbtu_source)
#table(fuel$fuel_type_code_pudl)
# Data cleaning and selecting relevant fields for fuel quality modeling
fuel_clean <- fuel %>%
select(
fuel_mmbtu_per_unit,
sulfur_content_pct,
ash_content_pct,
mercury_content_ppm
) %>%
# convert "null" strings to NA
mutate(
mercury_content_ppm = na_if(mercury_content_ppm, "null"),
mercury_content_ppm = as.numeric(mercury_content_ppm)
)
#glimpse(fuel_clean)
fuel_sample <- fuel_clean %>%
sample_frac(0.02)
# Median imputation
median_mercury <- median(fuel_sample$mercury_content_ppm, na.rm = TRUE)
cluster_vars_q <- fuel_sample %>%
mutate(
mercury_content_ppm = ifelse(
is.na(mercury_content_ppm),
median_mercury,
mercury_content_ppm
)
) %>%
drop_na()
# Scale variables for normalization
preProc <- preProcess(cluster_vars_q, method = c("center", "scale"))
cluster_scaled_q <- predict(preProc, cluster_vars_q)
# Cluster output
# glimpse(cluster_scaled_q)
# Elbow
wss <- map_dbl(1:10, function(k) {
kmeans(cluster_scaled_q, centers = k, nstart = 20)$tot.withinss
})
elbow_df <- tibble(
k = 1:10,
wss = wss
)
# Silhouette
sil_width <- map_dbl(2:10, function(k) {
km <- kmeans(cluster_scaled_q, centers = k, nstart = 20)
ss <- silhouette(km$cluster, dist(cluster_scaled_q))
mean(ss[, 3])
})
sil_df <- tibble(
k = 2:10,
silhouette = sil_width
)
ggplot(sil_df, aes(k, silhouette)) +
geom_line() +
geom_point(size = 2) +
theme_minimal() +
labs(
title = "Silhouette Method for Optimal K",
x = "Number of clusters (K)",
y = "Average silhouette width"
)
# Plot elbow curve
ggplot(elbow_df, aes(x = k, y = wss)) +
geom_line() +
geom_point(size = 2) +
theme_minimal() +
labs(
title = "Elbow Method for Fuel Quality Clustering",
x = "Number of clusters (K)",
y = "Within-cluster sum of squares"
)
k_final <- 4
final_kmeans <- kmeans(cluster_scaled_q, centers = k_final, nstart = 20)
cluster_results <- cluster_vars_q %>%
mutate(cluster = final_kmeans$cluster)
# -------------------------
# 8. Cluster summaries
# -------------------------
cluster_results %>%
group_by(cluster) %>%
summarise(across(everything(), mean), .groups = "drop")
km4 <- kmeans(cluster_scaled_q, centers = 4, nstart = 20)
clustered_data <- cluster_vars_q %>%
mutate(cluster = km4$cluster)
cluster_profile <- clustered_data %>%
group_by(cluster) %>%
summarise(
n = n(),
across(
where(is.numeric),
list(mean = mean, sd = sd),
.names = "{col}_{fn}"
),
.groups = "drop"
)
cluster_profile
km3 <- kmeans(cluster_scaled_q, centers = 3, nstart = 20)
table(
K3 = km3$cluster,
K4 = km4$cluster
)
